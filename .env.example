# Copy this file to .env and fill in your own EmailJS credentials.
# Get these from https://dashboard.emailjs.com after creating an account,
# an email service, and an email template.
#
# NOTE: these are exposed in the built JS bundle (that's how EmailJS works
# from a static site) - don't put anything secret here beyond your public key.

VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key
